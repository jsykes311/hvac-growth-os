OPENAI_API_KEY=
FIRECRAWL_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

HVAC_GROWTH_OS_AUTH_SECRET=
HVAC_GROWTH_OS_USERS=[{"email":"admin@talltwin.com","name":"TallTwin Admin","role":"Admin","passwordHash":"replace-with-sha256-password-hash","clientIds":[]}]

# Optional but recommended in production: stores encrypted OAuth credential payloads durably.
DATABASE_URL=

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google-ads/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_ADS_API_VERSION=v19
# For production, point this at durable storage or replace file storage with database token storage.
GOOGLE_ADS_TOKEN_STORE_PATH=/tmp/hvac-growth-os-google-ads-store.json

HIGHLEVEL_CLIENT_ID=
HIGHLEVEL_CLIENT_SECRET=
HIGHLEVEL_REDIRECT_URI=http://localhost:3000/api/highlevel/callback
HIGHLEVEL_API_KEY=
HIGHLEVEL_PRIVATE_INTEGRATION_TOKEN=
HIGHLEVEL_LOCATION_ID=
HIGHLEVEL_TOKEN_ENCRYPTION_KEY=
HIGHLEVEL_OAUTH_SCOPES=locations.readonly contacts.readonly opportunities.readonly conversations.readonly calendars.readonly forms.readonly tags.readonly workflows.readonly custom-fields.readonly
HIGHLEVEL_API_VERSION=2021-07-28
# For production, prefer HIGHLEVEL_PRIVATE_INTEGRATION_TOKEN + HIGHLEVEL_LOCATION_ID in Render env vars.
HIGHLEVEL_TOKEN_STORE_PATH=/tmp/hvac-growth-os-highlevel-store.json
